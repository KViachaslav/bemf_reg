# ---------------------------------------------------------------------------
#  Нормализация переводов строк: в репозитории LF, на диске Windows — CRLF.
# ---------------------------------------------------------------------------
* text=auto

# Бинарные файлы — никакой конвертации
*.elf   binary
*.bin   binary
*.hex   binary
*.o     binary
*.a     binary
*.ico   binary
*.png   binary
*.jpg   binary

# Исходники, скрипты и документы — всегда текст
*.c      text
*.h      text
*.s      text
*.ps1    text
*.md     text
*.html   text
*.ioc    text
*.ld     text
*.txt    text
